rules_version = '2';

// FitAI Firestore Security Rules — Phase 0 baseline
// Deploy with: firebase deploy --only firestore:rules
// Test with the Firebase Emulator: firebase emulators:start --only firestore
//
// These rules enforce authentication for all reads and writes, and restrict
// document writes to the owning user. They must be extended in Phase 2
// when the trainer-client relationship model is introduced.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNotLocalUser() {
      // Local/guest users have UIDs starting with "local_" but they are not
      // Firebase Auth users, so request.auth.uid never has that prefix.
      // This helper is here for documentation clarity.
      return isSignedIn();
    }

    // ── Public user profiles ──────────────────────────────────────────────
    // Minimal public record: name, avatarLevel. Written by the owning user only.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ── Community servers ─────────────────────────────────────────────────
    match /servers/{serverId} {
      // Anyone signed in can read public servers
      allow read: if isSignedIn() && (resource == null || resource.data.isPublic == true ||
                     resource.data.ownerId == request.auth.uid);
      // Only the server owner can update or delete
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ── Channels ──────────────────────────────────────────────────────────
    match /channels/{channelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
      // TODO Phase 2: restrict channel create/update/delete to server owners only
    }

    // ── Messages ──────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isSignedIn();
      // Only the message author can create their own messages
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // Only the author can edit or soft-delete their own messages
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if false; // soft-delete only via isDeleted field
    }

    // ── Server members ────────────────────────────────────────────────────
    match /server_members/{memberId} {
      allow read: if isSignedIn();
      // Member can only create/update their own membership document
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ── Friends ───────────────────────────────────────────────────────────
    match /friend_requests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUserId == request.auth.uid ||
         resource.data.toUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.fromUserId == request.auth.uid ||
         resource.data.toUserId == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() &&
        (resource.data.userId1 == request.auth.uid ||
         resource.data.userId2 == request.auth.uid);
      allow create: if isSignedIn();
      allow delete: if isSignedIn() &&
        (resource.data.userId1 == request.auth.uid ||
         resource.data.userId2 == request.auth.uid);
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    match /post_reactions/{reactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /post_comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if false;
    }

    // ── Rep battles ───────────────────────────────────────────────────────
    match /rep_battles/{battleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();

      match /rep_battle_entries/{entryId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() &&
          request.resource.data.userId == request.auth.uid;
      }
    }

    // ── Live calls (WebRTC signaling) ─────────────────────────────────────
    match /live_calls/{callId} {
      allow read, write: if isSignedIn();

      match /host_ice/{iceId} {
        allow read, write: if isSignedIn();
      }
      match /guest_ice/{iceId} {
        allow read, write: if isSignedIn();
      }
      match /rep_counts/{countId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── Workout sessions (synced for trainer access) ──────────────────────
    match /workoutSessions/{sessionId} {
      // Owner can read/write their own sessions
      allow read, write: if isSignedIn() && sessionId.matches(request.auth.uid + '_.*');
      // Trainers can read their clients' sessions (validated via trainer_clients)
      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/trainer_clients/$(request.auth.uid + '_' + resource.data.userId)) &&
        get(/databases/$(database)/documents/trainer_clients/$(request.auth.uid + '_' + resource.data.userId)).data.status == 'active';
    }

    // ── Trainer–client relationships ──────────────────────────────────────
    match /trainer_clients/{relationId} {
      // Trainers can read/write their own client relationships
      allow read, create, update: if isSignedIn() && resource == null
        ? request.resource.data.trainerId == request.auth.uid
        : resource.data.trainerId == request.auth.uid;
      // Clients can read their own trainer relationship
      allow read: if isSignedIn() && resource.data.clientId == request.auth.uid;
    }

    // ── Trainer invites ────────────────────────────────────────────────────
    match /trainer_invites/{inviteId} {
      allow read, create: if isSignedIn() && (
        resource == null
          ? request.resource.data.trainerId == request.auth.uid
          : resource.data.trainerId == request.auth.uid
      );
      // Anyone signed in can update status (accept/decline)
      allow update: if isSignedIn();
    }

    // ── Trainer alerts ─────────────────────────────────────────────────────
    match /trainer_alerts/{alertId} {
      allow read, create, update, delete: if isSignedIn() &&
        (resource == null
          ? request.resource.data.trainerId == request.auth.uid
          : resource.data.trainerId == request.auth.uid);
    }

    // ── Trainer notes ──────────────────────────────────────────────────────
    match /trainer_notes/{noteId} {
      allow read, create, update, delete: if isSignedIn() &&
        (resource == null
          ? request.resource.data.trainerId == request.auth.uid
          : resource.data.trainerId == request.auth.uid);
    }

    // ── Client status snapshots ────────────────────────────────────────────
    match /client_status_snapshots/{snapshotId} {
      allow read, write: if isSignedIn() && (
        resource == null
          ? request.resource.data.trainerId == request.auth.uid
          : resource.data.trainerId == request.auth.uid
      );
    }

    // ── Deny everything else ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
